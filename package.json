{
  "name": "dsh-websift",
  "version": "1.0.8",
  "description": "Token-efficient web reading for DeepSeek Harness, powered by a real Chrome over CDP. One call fetches several pages, gates them by relevance and returns a single digest (80-98% fewer context tokens). Real search URLs, login flow, screenshots, auto proxy.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./docs/icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "locale",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": "KNLCXY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KNLCXY/dsh-websift.git"
  },
  "homepage": "https://github.com/KNLCXY/dsh-websift#readme",
  "bugs": {
    "url": "https://github.com/KNLCXY/dsh-websift/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "browser",
    "browser-automation",
    "headless-chrome",
    "chrome-devtools-protocol",
    "cdp",
    "web-search",
    "web-scraping",
    "screenshot",
    "proxy",
    "clash",
    "agent-tools",
    "token-saving",
    "llm-context"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [],
      "external": []
    }
  },
  "scripts": {
    "test": "node test/test-rank.mjs && node test/test-failed.mjs && node test/test-route.mjs && node test/test-deadproxy.mjs && node test/test-window.mjs && node test/test-serial.mjs",
    "test:rank": "node test/test-rank.mjs",
    "test:failed": "node test/test-failed.mjs",
    "test:route": "node test/test-route.mjs",
    "test:deadproxy": "node test/test-deadproxy.mjs",
    "test:window": "node test/test-window.mjs",
    "test:serial": "node test/test-serial.mjs",
    "diag:json": "node test/test-json.mjs",
    "diag:digest": "node test/test-digest.mjs",
    "diag:find": "node test/test-find.mjs",
    "diag:offline": "node test/test-offline.mjs",
    "diag:cmp": "node test/cmp-route.mjs"
  }
}
