{
  "name": "dsh-browser-kernel",
  "version": "0.9.10",
  "description": "A real browser for DeepSeek Harness: headless Chrome + CDP behind four agent tools (browser / web_find / web_digest / browser_proxy). JS-rendered pages, screenshots, DOM eval, a login flow, auto proxy switching, and an extractive digest pipeline that cuts context tokens by 80-98%.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./docs/icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "locale",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": "KNLCXY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KNLCXY/dsh-browser-kernel.git"
  },
  "homepage": "https://github.com/KNLCXY/dsh-browser-kernel#readme",
  "bugs": {
    "url": "https://github.com/KNLCXY/dsh-browser-kernel/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "browser",
    "browser-automation",
    "headless-chrome",
    "chrome-devtools-protocol",
    "cdp",
    "web-search",
    "web-scraping",
    "screenshot",
    "proxy",
    "clash",
    "agent-tools",
    "token-saving",
    "llm-context"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [],
      "external": []
    }
  },
  "scripts": {
    "test": "node test/test-rank.mjs",
    "test:json": "node test/test-json.mjs",
    "test:digest": "node test/test-digest.mjs",
    "test:find": "node test/test-find.mjs",
    "test:offline": "node test/test-offline.mjs"
  }
}
